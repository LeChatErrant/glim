{
  "expo": {
    "name": "Glim",
    "slug": "hue-lab",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.lechaterrant.huelab"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050506",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.lechaterrant.huelab",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": [
      "glim",
      "huelab"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Rooms",
              "label": "Rooms",
              "description": "Tap a room to turn it on or off",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Map",
              "label": "Map",
              "description": "Your floor plan. Tap a light to toggle it",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            }
          ],
          "fonts": [
            "./node_modules/@expo-google-fonts/jost/300Light/Jost_300Light.ttf",
            "./node_modules/@expo-google-fonts/jost/400Regular/Jost_400Regular.ttf",
            "./node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
            "./node_modules/@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf"
          ]
        }
      ],
      [
        "./plugins/with-fast-widgets",
        {
          "widgets": [
            "Rooms",
            "Map"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "extraProguardRules": "# WorkManager (used by the widget library) instantiates workers, input mergers\n# and its Room database by reflection.\n-keep class androidx.work.** { *; }\n-keep class * extends androidx.work.ListenableWorker { <init>(...); }\n-keep class * extends androidx.work.InputMerger { <init>(); }\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class com.reactnativeandroidwidget.** { *; }\n# Local Expo modules: records are read by reflection.\n-keep class io.lechaterrant.** { *; }"
          }
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Glim uses your location once to show the weather around your home on the map."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050506",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "cloudServer": "https://glim-server.expo.app",
      "eas": {
        "projectId": "5a6debbe-68f6-4d6d-a86d-c4bff94a6165"
      }
    },
    "owner": "lechaterrant"
  }
}
