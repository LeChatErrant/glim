{
  "expo": {
    "name": "hue-lab",
    "slug": "hue-lab",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.lechaterrant.huelab"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.lechaterrant.huelab",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "huelab",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Rooms",
              "label": "Rooms",
              "description": "Tap a room to turn it on or off",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Map",
              "label": "Map",
              "description": "Your floor plan. Tap a light to toggle it",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "./plugins/with-fast-widgets",
        {
          "widgets": [
            "Rooms",
            "Map"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "extraProguardRules": "# WorkManager (used by the widget library) instantiates workers, input mergers\n# and its Room database by reflection.\n-keep class androidx.work.** { *; }\n-keep class * extends androidx.work.ListenableWorker { <init>(...); }\n-keep class * extends androidx.work.InputMerger { <init>(); }\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class com.reactnativeandroidwidget.** { *; }\n# Local Expo modules: records are read by reflection.\n-keep class io.lechaterrant.** { *; }"
          }
        }
      ]
    ]
  }
}
